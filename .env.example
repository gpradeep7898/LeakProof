# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/leakproof

# Shopify App credentials (required)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
NEXT_PUBLIC_SHOPIFY_API_KEY=   # Same value as SHOPIFY_API_KEY — used client-side by App Bridge

# App URL (must match Shopify Partner Dashboard redirect allowlist)
NEXT_PUBLIC_APP_URL=https://your-domain.com
