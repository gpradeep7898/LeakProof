# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/leakproof

# Shopify App credentials (required)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
NEXT_PUBLIC_SHOPIFY_API_KEY=   # Same value as SHOPIFY_API_KEY — used client-side by App Bridge

# App URL (must match Shopify Partner Dashboard redirect allowlist)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Token encryption (Phase 2) — 32 random bytes hex-encoded. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Billing: 'true' = test charges (dev stores), 'false' = real charges. Default: test outside production.
BILLING_TEST_MODE=

# Redis (rate limiting + BullMQ). Optional — in-memory fallback when unset.
REDIS_URL=

# Local dev only: bypass auth + billing to use the first store. NEVER set in production.
ALLOW_DEV_UNAUTHENTICATED=
